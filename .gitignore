# Sorties de compilation
build/
.gradle/
.kotlin/
.cxx/
.idea/
*.iml
local.properties

# Signature : la clé et ses mots de passe restent hors du dépôt.
# Une clé publiée laisse n'importe qui signer une mise à jour qu'Android accepterait
# par-dessus l'application installée. Les sauvegarder ailleurs qu'ici : sans elles,
# plus aucune mise à jour ne s'installe.
keystore/
keystore.properties
*.jks
*.keystore
*mot-de-passe*
*MOT-DE-PASSE*
*password*

# Binaires et archives de sources : ils vont dans les releases, pas dans l'historique.
*.apk
*.aab
*.zip

# Outils locaux
.claude/
