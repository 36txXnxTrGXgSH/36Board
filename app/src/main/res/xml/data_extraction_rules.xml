<?xml version="1.0" encoding="utf-8"?>
<!--
    Le dictionnaire personnel contient des mots réellement tapés par l'utilisateur.
    Il ne doit sortir ni vers une sauvegarde cloud, ni vers un autre téléphone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
